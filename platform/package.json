{
  "name": "skyvern-saas-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Closed-source healthcare automation SaaS backed by a self-hosted Skyvern instance (REST-only boundary).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "pnpm --filter @platform/db generate",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "db:seed": "pnpm --filter @platform/db seed",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @platform/api dev",
    "dev:web": "pnpm --filter @platform/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
