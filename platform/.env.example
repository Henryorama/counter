# ---- Database ----
DATABASE_URL="postgresql://app:app@localhost:5432/skyvern_saas?schema=public"
SHADOW_DATABASE_URL="postgresql://app:app@localhost:5432/skyvern_saas_shadow?schema=public"

# ---- API service ----
API_PORT=4000
# Public base URL of THIS api service; Skyvern calls back here for webhooks + TOTP pulls.
API_PUBLIC_URL="http://localhost:4000"

# ---- Skyvern (self-hosted, REST-only boundary) ----
SKYVERN_BASE_URL="http://localhost:8000"
# Per-tenant keys live in a secrets manager in production; this is a dev fallback only.
SKYVERN_API_KEY="dev-skyvern-api-key"

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
